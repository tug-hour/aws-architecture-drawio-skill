  "glossary": [
    {
      "asset_id": "aws4.aurora",
      "short_name": "DB切替",
      "full_name": "大阪クラスター昇格→書込先確認→API切替。通常時の大阪は読取専用",
      "kind": "note"
    },
    {
      "asset_id": "aws4.aurora",
      "short_name": "DB複製線",
      "full_name": "クラスターの共有ストレージ間複製を代表インスタンスへ接続。各地域のストレージはAWSが3AZへ自動複製",
      "kind": "note"
    },
    {
      "asset_id": "aws4.iot_core",
      "short_name": "IoT切替",
      "full_name": "両地域の証明書・ポリシー・Rulesを準備。デバイスとブラウザが接続先を変更して再接続",
      "kind": "note"
    },
    {
      "asset_id": "aws4.sqs",
      "short_name": "非同期復旧",
      "full_name": "SQS/EventBridgeは自動複製しない。Outbox/処理記録から再投入し、冪等に処理（補助図参照）",
      "kind": "note"
    },
    {
      "asset_id": "aws4.fargate",
      "short_name": "主図のECS",
      "full_name": "APIとワーカー群を2AZへ配置する代表記号。待機系は最小規模・切替時に増強",
      "kind": "note"
    },
    {
      "asset_id": "aws4.iot_core",
      "short_name": "画面認証",
      "full_name": "両地域のCognito/IAM/IoT policyを準備。切替時に認証と購読を再確立（補助図参照）",
      "kind": "note"
    },
    {
      "asset_id": "aws4.route_53",
      "short_name": "線の意味",
      "full_name": "実線のラベルで通常／障害時／複製／関連付けを区別。関連付けは矢印なし",
      "kind": "note"
    },
    {
      "asset_id": "aws4.s3",
      "short_name": "主図のS3",
      "full_name": "SPAバケット。履歴バケット/Firehose/AthenaはIoT補助図に示し、両地域へ別途配備する",
      "kind": "note"
    },
    {
      "asset_id": "aws4.route_53",
      "short_name": "API通信",
      "full_name": "CloudFrontで取得したSPAをブラウザで実行し、別APIホスト名でALBへHTTPS接続。Route 53は名前解決のみ",
      "kind": "note"
    },
    {
      "asset_id": "aws4.user",
      "short_name": "ブラウザの再掲",
      "full_name": "左は通常接続、右は同じSPAが接続先を切り替えた状態。logical_id=web-clientで同一主体と宣言",
      "kind": "note"
    },
    {
      "asset_id": "aws4.sqs",
      "short_name": "主図のSQS線",
      "full_name": "APIのOutbox発行→EventBridge→SQSとワーカー取得をまとめた双方向線。実際のサービスと方向は非同期補助図で示す",
      "kind": "note"
    }
  ],
