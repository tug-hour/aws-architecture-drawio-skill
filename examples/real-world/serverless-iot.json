{
  "schema_version": "1.0",
  "theme": "both",
  "layout": {
    "mode": "manual",
    "positions": [
      {
        "node_id": "device",
        "x_pt": 40,
        "y_pt": 220
      },
      {
        "node_id": "iot",
        "x_pt": 340,
        "y_pt": 220
      },
      {
        "node_id": "stream",
        "x_pt": 670,
        "y_pt": 220
      },
      {
        "node_id": "lambda",
        "x_pt": 1000,
        "y_pt": 220
      },
      {
        "node_id": "state",
        "x_pt": 1370,
        "y_pt": 220
      },
      {
        "node_id": "firehose",
        "x_pt": 670,
        "y_pt": 590
      },
      {
        "node_id": "archive",
        "x_pt": 1000,
        "y_pt": 590
      },
      {
        "node_id": "athena",
        "x_pt": 1370,
        "y_pt": 590
      }
    ]
  },
  "canvas": {
    "mode": "auto"
  },
  "nodes": [
    {
      "id": "device",
      "asset_id": "aws4.client",
      "label": "IoTデバイス"
    },
    {
      "id": "iot",
      "asset_id": "aws4.iot_core",
      "label": "AWS IoT Core",
      "group_id": "region",
      "description": "デバイス受付・ルール"
    },
    {
      "id": "stream",
      "asset_id": "aws4.kinesis_data_streams",
      "label": "Amazon Kinesis\nData Streams",
      "group_id": "region",
      "description": "順序単位：deviceId"
    },
    {
      "id": "lambda",
      "asset_id": "aws4.lambda",
      "label": "AWS Lambda",
      "group_id": "region",
      "description": "検証・冪等な集計"
    },
    {
      "id": "state",
      "asset_id": "aws4.dynamodb",
      "label": "Amazon DynamoDB",
      "group_id": "region",
      "description": "最新状態・Global Tables"
    },
    {
      "id": "firehose",
      "asset_id": "aws4.kinesis_data_firehose",
      "label": "Amazon Data Firehose",
      "group_id": "region",
      "description": "履歴の集約保存"
    },
    {
      "id": "archive",
      "asset_id": "aws4.s3",
      "label": "Amazon S3",
      "group_id": "region",
      "description": "履歴・Parquet"
    },
    {
      "id": "athena",
      "asset_id": "aws4.athena",
      "label": "Amazon Athena",
      "group_id": "region",
      "description": "履歴分析"
    }
  ],
  "edges": [
    {
      "id": "ingest",
      "source": "device",
      "target": "iot",
      "direction": "forward",
      "label": "MQTT/TLS・X.509"
    },
    {
      "id": "rule",
      "source": "iot",
      "target": "stream",
      "direction": "forward",
      "label": "ルール"
    },
    {
      "id": "consume",
      "source": "stream",
      "target": "lambda",
      "direction": "forward",
      "label": "イベントソース"
    },
    {
      "id": "write",
      "source": "lambda",
      "target": "state",
      "direction": "forward",
      "label": "冪等更新"
    },
    {
      "id": "history",
      "source": "iot",
      "target": "firehose",
      "direction": "forward",
      "label": "ルール"
    },
    {
      "id": "save",
      "source": "firehose",
      "target": "archive",
      "direction": "forward",
      "label": "配信"
    },
    {
      "id": "query",
      "source": "athena",
      "target": "archive",
      "direction": "forward",
      "label": "クエリ",
      "source_side": "left",
      "target_side": "right"
    }
  ],
  "groups": [
    {
      "id": "aws",
      "type": "group.aws-cloud",
      "role": "containment",
      "label": "AWS Cloud"
    },
    {
      "id": "region",
      "type": "group.region",
      "role": "containment",
      "label": "東京・IoT処理（大阪にも同等基盤）",
      "parent_id": "aws"
    }
  ]
}